#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 22 10>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 22 10>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <310>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/
{
    /* Encoder behaviors */
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Thumb cluster policy (your request):
         * - "space" position is NOT used as Space (you said Space exists elsewhere)
         * - Layer keys are momentary only: &mo 1 / &mo 2 / &mo 3
         * - Bottom thumb row: MB1 / MB2 / Layer3 (momentary)
         */

        /* =========================
         * layer0 (Base)
         * ========================= */
        layer_0 {
            bindings = <
                &kp ESC         &kp N1   &kp N2   &kp N3   &kp N4    &kp N5      &kp N6   &kp N7   &kp N8    &kp N9    &kp N0     &kp BACKSPACE
                &kp TAB         &kp Q    &kp W    &kp E    &kp R     &kp T       &kp Y    &kp U    &kp I     &kp O     &kp P      &kp RBKT
                &kp LSHIFT      &kp A    &kp S    &kp D    &kp F     &kp G       &kp H    &kp J    &kp K     &kp L     &kp SEMI   &kp COLON
                &kp LCTRL       &kp Z    &kp X    &kp C    &kp V     &kp B       &kp N    &kp M    &kp DOT   &kp DOT   &kp FSLH   &kp MINUS

                                              &kp LALT   &none     &mo 1       &mo 2     &kp ENTER
                                                        &mkp MB1  &mkp MB2    &mo 3
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,    /* encoder1: vertical scroll */
                <&scroll_horizontal_encoder>;  /* encoder2: horizontal scroll */
        };

        /* =========================
         * layer1 (Ctrl shortcuts)
         * ========================= */
        layer_1 {
            bindings = <
                &kp ESC         &none     &none     &none     &none     &none      &none     &none     &none      &none     &none     &none
                &kp TAB         &none     &none     &none     &none     &none      &none     &none     &none      &none     &none     &none
                &kp CAPS        &kp LC(A) &none     &none     &none     &none      &none     &none     &none      &none     &none     &none
                &kp LCTRL       &kp LC(Z) &none     &kp LC(C) &kp LC(V) &none      &none     &none     &none      &kp LC(Y) &none     &none

                                              &kp LALT   &none     &trans      &mo 2     &kp ENTER
                                                        &mkp MB1  &mkp MB2    &mo 3
            >;
            
             sensor-bindings =
                <&scroll_vertical_encoder>,    /* encoder1: vertical scroll */
                <&scroll_horizontal_encoder>;  /* encoder2: horizontal scroll */
        };

        /* =========================
         * layer2 (F-keys / symbols / del / home / end)
         * ========================= */
        layer_2 {
            bindings = <
                &kp ESC         &kp F1    &kp F2    &kp F3    &kp F4    &kp F5     &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &none
                &kp TAB         &kp EXCL  &kp DQT   &kp HASH  &kp DLLR  &kp PRCNT  &kp AMPS  &kp SQT   &kp LPAR  &kp RPAR  &kp DEL   &none
                &kp CAPS        &none     &none     &kp LBKT  &kp SEMI  &kp LPAR   &kp RPAR  &kp COLON &kp RBKT  &kp AT    &none     &kp HOME
                &kp LCTRL       &kp LGUI  &none     &none     &none     &kp COMMA  &kp DOT   &kp FSLH  &none     &none     &none     &kp END

                                              &kp LALT   &none     &mo 1       &trans    &kp ENTER
                                                        &mkp MB1  &mkp MB2    &mo 3
            >; 

             sensor-bindings =
                <&scroll_vertical_encoder>,    /* encoder1: vertical scroll */
                <&scroll_horizontal_encoder>;  /* encoder2: horizontal scroll */
        };

        /* =========================
         * layer3 (M1..M10 as F13..F22 + arrows)
         * =========================
         * ZMK has no "M1..M10" keycodes.
         * Using F13..F22 is common for macro layers.
         */
        layer_3 {
            bindings = <
                &kp ESC         &kp F13   &kp F14   &kp F15   &kp F16   &kp F17    &kp F18   &kp F19   &kp F20   &kp F21   &kp F22   &none
                &kp TAB         &none     &none     &none     &none     &none      &none     &none     &kp UP    &none     &none     &none
                &kp CAPS        &none     &none     &none     &none     &none      &none     &kp LEFT  &kp DOWN  &kp RIGHT &none     &none
                &kp LCTRL       &kp LGUI  &none     &none     &none     &none      &none     &none     &none     &none     &none     &none

                                              &kp LALT   &none     &mo 1       &mo 2     &kp ENTER
                                                        &mkp MB1  &mkp MB2    &trans
            >;
               sensor-bindings =
                <&scroll_vertical_encoder>,    /* encoder1: vertical scroll */
                <&scroll_horizontal_encoder>;  /* encoder2: horizontal scroll */
        };
    };
};
