#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12

/* タップ系の共通設定（そのままでOK） */
&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/* ポインタ(トラックボール)とスクロールの倍率系（整数のみ） */
&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/
{
    /* エンコーダ（スクロールホイール） */
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        /* =========================================================
         * layer0（BASE）※画像の layer0
         * - Layer1/2/3 は押してる間だけ：&mo
         * - 親指 "space" 位置は SPACE を入れる（要望どおり）
         * ========================================================= */
        layer_0 {
            bindings = <
                &kp ESC    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5     &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp BSPC
                &kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T      &kp Y    &kp U    &kp I    &kp O    &kp P    &kp RBKT
                &kp LSHFT  &kp A    &kp S    &kp D    &kp F    &kp G      &kp H    &kp J    &kp K    &kp L    &kp SEMI &kp COLON
                &kp LCTRL  &kp Z    &kp X    &kp C    &kp V    &kp B      &kp N    &kp M    &kp DOT  &kp DOT  &kp FSLH &kp MINUS

                                   &kp LALT  &kp SPACE  &mo 1     &mo 2     &kp ENTER
                                            &mkp MB1   &mkp MB2  &mo 3
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        /* =========================================================
         * layer1（ショートカット）※画像の layer1
         *
         * 左手側：
         *  - TAB行：E=HOME, R=WIN+R, T=HOME
         *  - CAPS行：W=BS, E=WIN+D, R=CTRL+C, T=BS
         *  - CTRL行：E=CTRL+Z, R=CTRL+A, T=CTRL+Y
         *
         * 右手側：
         *  - TAB行：U/I/O = END
         *  - CAPS行：Y=DEL, U=CTRL+V, I=DEL
         *  - CTRL行：U=CTRL+V
         * ========================================================= */
        layer_1 {
            bindings = <
                &kp ESC    &none    &none    &none     &none     &none      &none     &none     &none     &none     &none     &none
                &kp TAB    &none    &none    &kp HOME  &kp LG(R) &kp HOME   &none     &kp END   &kp END   &kp END   &none     &none
                &kp CAPS   &none    &kp BSPC &kp LG(D) &kp LC(C) &kp BSPC   &kp DEL   &kp LC(V) &kp DEL   &none     &none     &none
                &kp LCTRL  &none    &none    &kp LC(Z) &kp LC(A) &kp LC(Y)  &none     &kp LC(V) &none     &none     &none     &none

                                   &kp LALT  &kp SPACE  &trans    &mo 2     &kp ENTER
                                            &mkp MB1   &mkp MB2  &mo 3
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        /* =========================================================
         * layer2（F1〜F10/記号/DEL/HOME/END）※画像の layer2
         * ========================================================= */
        layer_2 {
            bindings = <
                &kp ESC    &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &none
                &kp TAB    &kp EXCL &kp DQT  &kp HASH &kp DLLR &kp PRCNT  &kp AMPS &kp SQT  &kp LPAR &kp RPAR &kp DEL  &none
                &kp CAPS   &none    &none    &kp LBKT &kp SEMI &kp LPAR   &kp RPAR &kp COLON&kp RBKT &kp AT   &none    &kp HOME
                &kp LCTRL  &kp LGUI &none    &none    &none    &kp DOT    &kp DOT  &kp FSLH &none    &none    &none    &kp END

                                   &kp LALT  &kp SPACE  &mo 1     &trans    &kp ENTER
                                            &mkp MB1   &mkp MB2  &mo 3
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        /* =========================================================
         * layer3（M1〜M10相当 + 矢印）※画像の layer3
         * - M1..M10 は ZMKに直接のキーコードがないので
         *   F13..F22 を割り当て（一般的な“マクロ層”の作り方）
         * ========================================================= */
        layer_3 {
            bindings = <
                &kp ESC    &kp F13  &kp F14  &kp F15  &kp F16  &kp F17    &kp F18  &kp F19  &kp F20  &kp F21  &kp F22  &none
                &kp TAB    &none    &none    &none    &none    &none     &none    &none    &kp UP   &none    &none    &none
                &kp CAPS   &none    &none    &none    &none    &none     &none    &kp LEFT &kp DOWN &kp RIGHT&none    &none
                &kp LCTRL  &kp LGUI &none    &none    &none    &none     &none    &none    &none    &none    &none    &none

                                   &kp LALT  &kp SPACE  &mo 1     &mo 2     &kp ENTER
                                            &mkp MB1   &mkp MB2  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };
    };
};
